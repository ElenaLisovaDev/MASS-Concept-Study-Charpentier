# ---------------------------------------------------------------
# Copy this file to ".env" and fill in your own values:
#   macOS/Linux:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
#
# The real .env is gitignored and must NEVER be committed.
# ---------------------------------------------------------------

# Required: Google / Gemini API key (used by crewai's Gemini LLM).
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Alternative name some tools also accept (set only if you use it):
# GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: enable crewai / litellm tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
